# Copy to .env and fill in real values. Never commit .env.

# Gemini — stock pick recommendations (buy.ts)
# Free key from Google AI Studio (https://aistudio.google.com/); no card required.
GEMINI_API_KEY=your-gemini-api-key-here

# Alpaca — paper trading only (config.ts sets paper: true)
ALPACA_API_KEY=your-alpaca-paper-key-id
ALPACA_SECRET_KEY=your-alpaca-paper-secret

# Firebase Realtime Database (config.ts, admin SDK)
FB_DB_URL=https://algosus-default-rtdb.firebaseio.com

# Shared secret for manual HTTP triggers (buy/sell/update).
# Generate a long random string; callers send it as the x-api-key header.
# Scheduled runs do not need it.
FUNCTIONS_API_KEY=generate-a-long-random-string
