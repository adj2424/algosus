# Copy to .env and fill in real values. Never commit .env.

# OpenAI — stock pick recommendations (buy.ts)
OPENAI_API_KEY=sk-your-openai-key-here

# Alpaca — paper trading only (config.ts sets paper: true)
ALPACA_API_KEY=your-alpaca-paper-key-id
ALPACA_SECRET_KEY=your-alpaca-paper-secret

# Firebase Realtime Database (config.ts)
FB_API_KEY=your-firebase-api-key
FB_DB_URL=https://algosus-default-rtdb.firebaseio.com
